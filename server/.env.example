# ============================================================
# AizuTrade — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- MongoDB ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/Aizu

# --- Neon (PostgreSQL + Auth) ---
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://<your-neon-auth-endpoint>/neondb/auth

# --- Server ---
PORT=5000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=https://aizu-trade-one.vercel.app
CORS_ORIGINS=https://aizu-trade-one.vercel.app

# --- Auth ---
JWT_SECRET=<your-long-random-secret-min-32-chars>

# --- Admin bootstrap (creates the admin account on first start) ---
ADMIN_NAME=Aizu
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=YourStrongPassword123

