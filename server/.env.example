# ============================================================
# AizuTrade — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- MongoDB ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/Aizu

# --- Neon (PostgreSQL + Auth) ---
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://<your-neon-auth-endpoint>/neondb/auth

# --- Server ---
PORT=5000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Auth ---
JWT_SECRET=<your-long-random-secret-min-32-chars>

# --- Admin bootstrap (creates the admin account on first start) ---
ADMIN_NAME=Aizu
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=YourStrongPassword123

# --- SMTP (optional — Neon Auth email is used by default) ---
# Only needed if you want to use your own SMTP for email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-google-app-password
MAIL_FROM=Aizu Trade <your@gmail.com>

